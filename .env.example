# Local development defaults.
# Docker Compose publishes PostgreSQL on host port 5433 (not 5432), so the
# JDBC URL below must match docker-compose.yml.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5433/homebase
JDBC_DATABASE_USERNAME=homebase
JDBC_DATABASE_PASSWORD=homebase
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/homebase
KEYCLOAK_CLIENT_ID=homebase-web
# Port the Spring Boot API binds to (see backend/src/main/resources/application.yml).
PORT=8082
